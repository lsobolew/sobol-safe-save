{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "wp": {
            "type": "string",
            "pattern": "^(latest(-\\d+)?|nightly|trunk|\\d+\\.\\d+(\\.\\d+)?)$"
          },
          "php": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
          },
          "port": {
            "type": "integer",
            "minimum": 1024,
            "maximum": 65535
          },
          "multisite": {
            "type": "boolean"
          },
          "locale": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "wp",
          "php",
          "port"
        ]
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "editions": {
      "type": "array",
      "items": {
        "enum": [
          "free",
          "pro"
        ]
      },
      "uniqueItems": true
    },
    "ports": {
      "type": "object",
      "properties": {
        "dashboard": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "mailpitUi": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "database": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      },
      "required": [],
      "patternProperties": { "^//": {} },
      "additionalProperties": false
    },
    "themes": {
      "type": "object",
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "available": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "alias": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "source": {
                "enum": [
                  "wporg",
                  "local"
                ]
              },
              "type": {
                "enum": [
                  "block",
                  "classic"
                ]
              },
              "path": {
                "type": "string"
              },
              "requiresWp": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+(\\.\\d+)?$"
              }
            },
            "required": [
              "slug"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "sweep": {
          "type": "object",
          "properties": {
            "targets": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "uniqueItems": true
            },
            "themes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "uniqueItems": true
            }
          },
          "required": []
        }
      },
      "required": [
        "default",
        "available"
      ]
    }
  },
  "required": [
    "targets"
  ]
}
