{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "my-plugin/item-list",
	"version": "0.1.0",
	"title": "Item list",
	"category": "widgets",
	"icon": "list-view",
	"description": "Displays the most recent items registered by the plugin.",
	"keywords": [ "items", "list" ],
	"textdomain": "my-plugin",
	"attributes": {
		"limit": {
			"type": "number",
			"default": 5
		}
	},
	"supports": {
		"html": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
