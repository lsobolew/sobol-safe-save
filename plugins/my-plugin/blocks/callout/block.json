{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "my-plugin/callout",
	"version": "0.1.0",
	"title": "Callout",
	"category": "text",
	"icon": "info-outline",
	"description": "A highlighted note saved directly into the post content.",
	"textdomain": "my-plugin",
	"attributes": {
		"message": {
			"type": "string",
			"source": "html",
			"selector": "p",
			"default": ""
		},
		"tone": {
			"type": "string",
			"default": "info"
		}
	},
	"supports": {
		"html": false,
		"anchor": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
