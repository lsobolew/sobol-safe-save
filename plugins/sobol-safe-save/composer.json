{
	"name": "myvendor/sobol-safe-save",
	"description": "A WordPress plugin scaffolded with WP Plugin Lab.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=7.4"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0",
		"brain/monkey": "^2.6",
		"mockery/mockery": "^1.6",
		"squizlabs/php_codesniffer": "^3.9",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.0",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^7.1"
	},
	"autoload": {
		"psr-4": {
			"Sobolewski\\SobolSafeSave\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Sobolewski\\SobolSafeSave\\Tests\\": "tests/"
		}
	},
	"config": {
		"platform": {
			"php": "7.4"
		},
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test:unit": "phpunit -c phpunit-unit.xml.dist",
		"test:integration": "phpunit -c phpunit-integration.xml.dist"
	}
}
